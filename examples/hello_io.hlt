// hello_io.hlt — stdlib import and IO (Phase 1 + stdlib)
// Demonstrates `import std::io`: `print`-family calls resolve to pure Holt
// wrappers in `stdlib/std/io.hlt` over `extern "c"` libc declarations.

import std::io

void main() do
    println("Hello, Holt!")
    print("no newline: ")
    println("continued")
    printInt(2026)
    putChar('!')
    println("")
end
