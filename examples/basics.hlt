// basics.hlt — Phase 1: functions, arithmetic, if/while, recursion
// Demonstrates the MVP executable subset (int/bool/void) with factorial and Fibonacci.

int factorial(int n) do
    if (n is 0) do
        return 1
    end
    int rec = factorial(n - 1)
    return rec * n
end

int fib(int n) do
    if n is 0 do
        return 0
    end
    if n is 1 do
        return 1
    end
    return fib(n - 1) + fib(n - 2)
end

int sumTo(int n) do
    int s = 0
    int i = 1
    while i <= n do
        s = s + i
        i = i + 1
    end
    return s
end

int main() do
    int f5 = factorial(5)   // 120
    int f10 = fib(10)       // 55
    int s10 = sumTo(10)     // 55
    // f5 + f10 + s10 = 230
    return f5 + f10 + s10
end
